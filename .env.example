# Cosy-Frontend environment configuration
#
# Copy this file to `.env.local` and adjust the values for your setup:
#   cp .env.example .env.local
#
# All variables are OPTIONAL for local development. When unset, the app falls
# back to the local-development defaults shown below (see src/config.ts).
# Only variables prefixed with VITE_ are exposed to the browser bundle by Vite,
# so never put secrets here.

# STOMP broker URL used for the realtime WebSocket connection.
# Default (unset): ws://localhost:8080/api/v1/ws
VITE_BACKEND_BROKER_URL=ws://localhost:8080/api/v1/ws

# HTTP(S) endpoint used as the SockJS WebSocket factory / handshake URL.
# Default (unset): http://localhost:8080/api/v1/ws
VITE_BACKEND_WEBSOCKET_FACTORY=http://localhost:8080/api/v1/ws
